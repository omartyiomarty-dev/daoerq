# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Long random string used to sign admin session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string
# Set to "false" only if you serve over plain HTTP without TLS (not recommended)
# COOKIE_SECURE=false
# Load protection: max public requests per second before shedding excess (admin excluded)
# MAX_PUBLIC_RPS=600
